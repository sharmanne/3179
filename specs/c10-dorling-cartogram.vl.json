{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling cartogram: each paddy-growing state is a circle whose area is the number of tonnes its paddy harvest changed between 2014 and 2024. Orange circles lost harvest and blue circles gained. Circles sit roughly where the states are. Kedah (259,159 t) and Sarawak (147,568 t) together account for about half of the net loss; only Pahang and Melaka grew.",
  "title": {
    "frame": "group",
    "text": ["Kedah and Sarawak account for half", "of the paddy harvest lost"],
    "subtitle": [
      "Change in paddy harvested, tonnes, 2014 to 2024.",
      "Circle area shows the size of the change. Circles sit",
      "roughly where each state is. Source: DOSM."
    ]
  },
  "width": 520,
  "height": 470,
  "autosize": {"type": "none"},
  "padding": {"left": 4, "right": 4, "top": 108, "bottom": 4},
  "data": {"url": "data/clean/paddy_change_by_state.csv", "format": {"type": "csv", "parse": {"production_2014_t": "number", "production_2024_t": "number", "change_t": "number", "change_pct": "number", "share_of_net_change_pct": "number", "x": "number", "y": "number", "size_px2": "number", "label_inside": "number", "label_x": "number", "label_y": "number"}}},
  "config": {
    "font": "Source Sans 3",
    "view": {"stroke": null},
    "title": {"font": "Fraunces", "fontSize": 20, "fontWeight": 600, "color": "#1F1B16", "anchor": "start", "offset": 10,
              "subtitleFont": "Source Sans 3", "subtitleFontSize": 13, "subtitleColor": "#5A5348", "subtitlePadding": 6}
  },
  "layer": [
    {
      "description": "One circle per state. Area = tonnes gained or lost (size_px2 is exactly proportional to the absolute change).",
      "params": [{"name": "hover", "select": {"type": "point", "fields": ["state"], "on": "mouseover", "clear": "mouseout"}}],
      "mark": {"type": "circle", "opacity": 0.92},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 520]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}, "axis": null},
        "size": {"field": "size_px2", "type": "quantitative", "scale": null, "legend": null},
        "color": {"field": "direction", "type": "nominal", "legend": null,
                  "scale": {"domain": ["lost", "gained"], "range": ["#D55E00", "#3A8FD6"]}},
        "stroke": {"condition": {"param": "hover", "empty": false, "value": "#1F1B16"}, "value": "#FBF8F3"},
        "strokeWidth": {"condition": {"param": "hover", "empty": false, "value": 3}, "value": 1.5},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "production_2014_t", "type": "quantitative", "title": "Paddy harvested 2014 (tonnes)", "format": ",.0f"},
          {"field": "production_2024_t", "type": "quantitative", "title": "Paddy harvested 2024 (tonnes)", "format": ",.0f"},
          {"field": "change_t", "type": "quantitative", "title": "Change (tonnes)", "format": "+,.0f"},
          {"field": "change_pct", "type": "quantitative", "title": "Change (%)", "format": "+.0f"}
        ]
      }
    },
    {
      "description": "Labels inside the big circles: name and change in tonnes",
      "transform": [
        {"filter": "datum.label_inside == 1"},
        {"calculate": "[datum.state, replace(format(datum.change_t, '+,.0f'), '-', '−') + ' t']", "as": "text_lines"}
      ],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "fontSize": 12.5, "fontWeight": 600, "lineHeight": 15, "color": "#1F1B16"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "text_lines", "type": "nominal"}
      }
    },
    {
      "description": "Labels beside the small circles (right-hand side)",
      "transform": [
        {"filter": "datum.label_inside == 0 && datum.label_align == 'left'"},
        {"calculate": "[datum.state, replace(format(datum.change_t, '+,.0f'), '-', '−') + ' t']", "as": "text_lines"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "fontSize": 12, "lineHeight": 14, "color": "#1F1B16"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "text_lines", "type": "nominal"}
      }
    },
    {
      "description": "Labels beside the small circles (left-hand side)",
      "transform": [
        {"filter": "datum.label_inside == 0 && datum.label_align == 'right'"},
        {"calculate": "[datum.state, replace(format(datum.change_t, '+,.0f'), '-', '−') + ' t']", "as": "text_lines"}
      ],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "fontSize": 12, "lineHeight": 14, "color": "#1F1B16"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "text_lines", "type": "nominal"}
      }
    },
    {
      "description": "Key: what the two colours mean",
      "data": {"values": [{"t": "Harvest fell", "y": 18, "d": "lost"}, {"t": "Harvest rose", "y": 40, "d": "gained"}]},
      "mark": {"type": "circle", "size": 130, "opacity": 0.92},
      "encoding": {
        "x": {"datum": 330, "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "color": {"field": "d", "type": "nominal", "legend": null, "scale": {"domain": ["lost", "gained"], "range": ["#D55E00", "#3A8FD6"]}}
      }
    },
    {
      "data": {"values": [{"t": "Harvest fell", "y": 18}, {"t": "Harvest rose", "y": 40}]},
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 14, "fontSize": 13, "color": "#1F1B16"},
      "encoding": {
        "x": {"datum": 330, "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "t", "type": "nominal"}
      }
    },
    {
      "description": "Annotation 1: the two biggest losers share half of the net loss",
      "transform": [
        {"window": [{"op": "rank", "as": "loss_rank"}], "sort": [{"field": "change_t", "order": "ascending"}]},
        {"filter": "datum.loss_rank <= 2"},
        {"aggregate": [{"op": "sum", "field": "share_of_net_change_pct", "as": "top2_share"}]},
        {"calculate": "'Kedah and Sarawak: ' + format(datum.top2_share, '.0f') + '% of the net loss'", "as": "note"}
      ],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "fontSize": 14, "fontWeight": 600, "color": "#9A4400"},
      "encoding": {
        "x": {"datum": 260, "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"datum": 458, "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "note", "type": "nominal"}
      }
    },
    {
      "description": "Annotation 2: only two states grew",
      "transform": [
        {"filter": "datum.direction == 'gained'"},
        {"aggregate": [{"op": "count", "as": "n_gained"}]},
        {"calculate": "['Only ' + datum.n_gained + ' states', 'harvested more:', 'Pahang and Melaka']", "as": "note"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "top", "fontSize": 12.5, "fontWeight": 600, "lineHeight": 15, "color": "#1F6DAF"},
      "encoding": {
        "x": {"datum": 350, "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"datum": 212, "type": "quantitative", "scale": {"domain": [0, 470], "reverse": true}},
        "text": {"field": "note", "type": "nominal"}
      }
    }
  ]
}
