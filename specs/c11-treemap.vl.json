{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Treemap of Malaysia's planted land in 2024 across the nine crop groups in DOSM's data. Rectangle area is hectares. Paddy takes 53% of the land, fruit 19%, industrial crops 11%, coconut 8% and vegetables 7%; four small groups share the last 2%. Paddy and fruit harvest almost the same weight (2.06 and 1.97 million tonnes) although fruit uses about a third of the land.",
  "title": {
    "frame": "group",
    "text": ["Paddy fills more than half of the", "crop land DOSM counts"],
    "subtitle": [
      "Planted area by crop group (rectangle area = hectares).",
      "Malaysia, 2024. Source: DOSM."
    ]
  },
  "width": 520,
  "height": 440,
  "autosize": {"type": "none"},
  "padding": {"left": 4, "right": 4, "top": 92, "bottom": 4},
  "data": {"url": "data/clean/landuse_treemap.csv", "format": {"type": "csv", "parse": {"planted_area_ha": "number", "production_t": "number", "share_pct": "number", "x0": "number", "y0": "number", "x1": "number", "y1": "number", "label_inside": "number", "label_lines": "number"}}},
  "config": {
    "font": "Source Sans 3",
    "view": {"stroke": null},
    "title": {"font": "Fraunces", "fontSize": 20, "fontWeight": 600, "color": "#1F1B16", "anchor": "start", "offset": 10,
              "subtitleFont": "Source Sans 3", "subtitleFontSize": 13, "subtitleColor": "#5A5348", "subtitlePadding": 6}
  },
  "layer": [
    {
      "description": "One rectangle per crop group. Area = hectares planted.",
      "params": [{"name": "hover", "select": {"type": "point", "fields": ["label"], "on": "mouseover", "clear": "mouseout"}}],
      "mark": {"type": "rect", "opacity": 1},
      "encoding": {
        "x": {"field": "x0", "type": "quantitative", "scale": {"domain": [0, 520]}, "axis": null},
        "x2": {"field": "x1"},
        "y": {"field": "y0", "type": "quantitative", "scale": {"domain": [0, 440], "reverse": true}, "axis": null},
        "y2": {"field": "y1"},
        "color": {"condition": {"test": "datum.crop_type == 'paddy'", "value": "#00553F"}, "value": "#D5CEC1"},
        "stroke": {"condition": {"param": "hover", "empty": false, "value": "#1F1B16"}, "value": "#FBF8F3"},
        "strokeWidth": {"condition": {"param": "hover", "empty": false, "value": 3}, "value": 2.5},
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Crop group"},
          {"field": "planted_area_ha", "type": "quantitative", "title": "Planted area (hectares)", "format": ",.0f"},
          {"field": "share_pct", "type": "quantitative", "title": "Share of land counted (%)", "format": ".1f"},
          {"field": "production_t", "type": "quantitative", "title": "Harvest (tonnes)", "format": ",.0f"}
        ]
      }
    },
    {
      "description": "Labels inside the rectangles that are big enough: name, share of land and, for the largest, weight harvested",
      "transform": [
        {"filter": "datum.label_inside == 1"},
        {"calculate": "(datum.x0 + datum.x1) / 2", "as": "cx"},
        {"calculate": "(datum.y0 + datum.y1) / 2", "as": "cy"},
        {"calculate": "datum.label_lines == 3 ? [datum.label, format(datum.share_pct, '.0f') + '% of the land', format(datum.production_t / 1000000, '.2f') + ' million t harvested'] : [datum.label, format(datum.share_pct, '.0f') + '%']", "as": "text_lines"}
      ],
      "mark": {"type": "text", "align": "center", "baseline": "middle", "fontSize": 13.5, "fontWeight": 600, "lineHeight": 17},
      "encoding": {
        "x": {"field": "cx", "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "cy", "type": "quantitative", "scale": {"domain": [0, 440], "reverse": true}},
        "text": {"field": "text_lines", "type": "nominal"},
        "color": {"condition": {"test": "datum.crop_type == 'paddy'", "value": "#FFFFFF"}, "value": "#1F1B16"}
      }
    },
    {
      "description": "Annotation: the four small groups, with a line to where they sit",
      "transform": [
        {"filter": "datum.label_inside == 0"},
        {"calculate": "(datum.x0 + datum.x1) / 2", "as": "cx"},
        {"calculate": "(datum.y0 + datum.y1) / 2", "as": "cy"},
        {"aggregate": [{"op": "mean", "field": "cx", "as": "cx"}, {"op": "mean", "field": "cy", "as": "cy"}, {"op": "sum", "field": "share_pct", "as": "small_share"}]},
        {"calculate": "'Cash crops, spices, flowers and herbs: ' + format(datum.small_share, '.1f') + '% together'", "as": "note"}
      ],
      "mark": {"type": "rule", "stroke": "#1F1B16", "strokeWidth": 1.2},
      "encoding": {
        "x": {"field": "cx", "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"field": "cy", "type": "quantitative", "scale": {"domain": [0, 440], "reverse": true}},
        "y2": {"datum": 414}
      }
    },
    {
      "transform": [
        {"filter": "datum.label_inside == 0"},
        {"aggregate": [{"op": "sum", "field": "share_pct", "as": "small_share"}]},
        {"calculate": "'Cash crops, spices, flowers and herbs: ' + format(datum.small_share, '.1f') + '% together'", "as": "note"}
      ],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "fontSize": 13, "fontWeight": 600, "color": "#1F1B16"},
      "encoding": {
        "x": {"datum": 520, "type": "quantitative", "scale": {"domain": [0, 520]}},
        "y": {"datum": 426, "type": "quantitative", "scale": {"domain": [0, 440], "reverse": true}},
        "text": {"field": "note", "type": "nominal"}
      }
    }
  ]
}
